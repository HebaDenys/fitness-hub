    <string name="privacy_rationale_purpose_sleep">Sleep: your nightly sleep duration and sleep trends.</string>
    <string name="privacy_rationale_purpose_heart_rate">Heart rate: your resting heart rate and recorded heart rate readings.</string>
    <string name="privacy_rationale_purpose_oxygen">Oxygen saturation: your SpO2 readings.</string>
    <string name="privacy_rationale_purpose_weight">Weight and body composition: your weight and body fat trends.</string>
